# ====================================================================
# FoodVerse AI — Environment Configuration Template
# ====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# CORS Origins (comma-separated list of allowed frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://foodverseai-1.onrender.com

# Database & Storage Configuration
# SQLite local file or PostgreSQL (e.g., postgresql+psycopg2://user:pass@localhost:5432/foodverse)
DATABASE_URL=sqlite:///./data/foodverse.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ====================================================================
# Google Gemini Multimodal AI Configuration (Primary AI Provider)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# ====================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AI Provider Configurations
# LLM Providers: 'gemini' (recommended), 'local'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Vision Providers: 'gemini' (recommended), 'local'
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
VISION_API_KEY=

# Nutrition Data Provider
# Leave blank to use FoodVerse verified local USDA FoodData composition database
NUTRITION_PROVIDER=local
NUTRITION_API_KEY=

# Frontend Environment Variables (for Vite development)
VITE_API_BASE_URL=http://localhost:8000/api/v1
